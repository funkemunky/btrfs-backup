[Desktop Entry]
Type=Application
Name=Btrfs Backup
Comment=Manage backup profiles, browse previous versions and restore files
Exec=btrfs-backup-gnome
Icon=drive-harddisk
Categories=GTK;GNOME;System;Archiving;
Keywords=backup;btrfs;restore;snapshot;
Terminal=false
StartupNotify=true
