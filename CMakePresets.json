{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default release development build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC debug development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang debug development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-manager-disabled",
      "displayName": "GCC debug build without the system manager",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-manager-disabled",
      "cacheVariables": {
        "BUILD_KDE_INTEGRATION": "OFF",
        "BUILD_SYSTEM_MANAGER": "OFF"
      }
    },
    {
      "name": "clang-manager-disabled",
      "displayName": "Clang debug build without the system manager",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-manager-disabled",
      "cacheVariables": {
        "BUILD_KDE_INTEGRATION": "OFF",
        "BUILD_SYSTEM_MANAGER": "OFF"
      }
    },
    {
      "name": "architecture",
      "displayName": "Clang architecture contract",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/architecture"
    },
    {
      "name": "asan-ubsan",
      "displayName": "Clang AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "BTRFSBACKUP_ARCHITECTURE_TESTS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Clang libFuzzer smoke tests",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "BUILD_KDE_INTEGRATION": "OFF",
        "BUILD_SYSTEM_MANAGER": "OFF",
        "BTRFSBACKUP_ARCHITECTURE_TESTS": "OFF",
        "BTRFSBACKUP_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "strict-warnings",
      "displayName": "Clang strict warnings",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/strict-warnings",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BTRFSBACKUP_ARCHITECTURE_TESTS": "OFF",
        "CMAKE_CXX_FLAGS": "-Werror -Wconversion -Wsign-conversion -Wshadow"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang-Tidy production analysis",
      "inherits": "clang-debug",
      "binaryDir": "${sourceDir}/build/clang-tidy",
      "cacheVariables": {
        "BUILD_KDE_INTEGRATION": "OFF",
        "BUILD_TESTING": "ON",
        "BTRFSBACKUP_ARCHITECTURE_TESTS": "OFF",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--config-file=${sourceDir}/.clang-tidy;--header-filter=^${sourceDir}/(apps|src|tests/integration)/"
      }
    },
    {
      "name": "gnome-debug",
      "displayName": "GCC debug build with GNOME 50 integration",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gnome-debug",
      "cacheVariables": {
        "BUILD_GNOME_INTEGRATION": "ON"
      }
    },
    {
      "name": "kde-debug",
      "displayName": "GCC debug build with KDE integration",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/kde-debug",
      "cacheVariables": {
        "BUILD_KDE_INTEGRATION": "ON"
      }
    },
    {
      "name": "kde-strict-warnings",
      "displayName": "Clang strict warnings for KDE integration",
      "inherits": "strict-warnings",
      "binaryDir": "${sourceDir}/build/kde-strict-warnings",
      "cacheVariables": {
        "BUILD_KDE_INTEGRATION": "ON"
      }
    },
    {
      "name": "manager-debug",
      "displayName": "GCC debug build with the system manager",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/manager-debug",
      "cacheVariables": {
        "BUILD_SYSTEM_MANAGER": "ON"
      }
    },
    {
      "name": "real-restore",
      "displayName": "Root-only real Btrfs restore integration",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/real-restore",
      "cacheVariables": {
        "BTRFSBACKUP_ARCHITECTURE_TESTS": "OFF",
        "BTRFSBACKUP_REAL_RESTORE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "gcc-manager-disabled",
      "configurePreset": "gcc-manager-disabled"
    },
    {
      "name": "clang-manager-disabled",
      "configurePreset": "clang-manager-disabled"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "btrfsbackup-profile-json-fuzzer",
        "btrfsbackup-path-input-fuzzer"
      ]
    },
    {
      "name": "strict-warnings",
      "configurePreset": "strict-warnings",
      "targets": [
        "btrfs-backup-native",
        "btrfs-backupctl",
        "btrfs-backupd",
        "btrfs-backup-device-preparation",
        "btrfsbackup-profile-schema-contract-tests",
        "btrfsbackup-real-restore-tests",
        "btrfsbackup-real-btrfs-tests",
        "btrfsbackup-integration-browse-session-client",
        "btrfsbackup-integration-device-provisioning-client",
        "btrfsbackup-fake-polkit-authority",
        "btrfsbackup-dbus-manager-tests"
      ]
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy",
      "targets": [
        "btrfs-backup-native",
        "btrfs-backupctl",
        "btrfs-backupd",
        "btrfs-backup-device-preparation",
        "btrfsbackup-profile-schema-contract-tests",
        "btrfsbackup-real-restore-tests",
        "btrfsbackup-real-btrfs-tests",
        "btrfsbackup-integration-browse-session-client",
        "btrfsbackup-integration-device-provisioning-client",
        "btrfsbackup-fake-polkit-authority",
        "btrfsbackup-dbus-manager-tests"
      ]
    },
    {
      "name": "kde-debug",
      "configurePreset": "kde-debug"
    },
    {
      "name": "gnome-debug",
      "configurePreset": "gnome-debug"
    },
    {
      "name": "kde-strict-warnings",
      "configurePreset": "kde-strict-warnings",
      "targets": [
        "btrfs-backup-kde"
      ]
    },
    {
      "name": "manager-debug",
      "configurePreset": "manager-debug"
    },
    {
      "name": "real-restore",
      "configurePreset": "real-restore"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-manager-disabled",
      "configurePreset": "gcc-manager-disabled",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-manager-disabled",
      "configurePreset": "clang-manager-disabled",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "architecture",
      "configurePreset": "architecture",
      "filter": {
        "include": {
          "label": "architecture"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "filter": {
        "include": {
          "label": "fuzz"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gnome",
      "configurePreset": "gnome-debug",
      "filter": {
        "include": {
          "label": "gnome"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "kde",
      "configurePreset": "kde-debug",
      "filter": {
        "include": {
          "label": "kde"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "manager",
      "configurePreset": "manager-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dbus",
      "configurePreset": "manager-debug",
      "filter": {
        "include": {
          "label": "dbus"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "workflow",
      "configurePreset": "default",
      "filter": {
        "include": {
          "label": "workflow"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "real-restore",
      "configurePreset": "real-restore",
      "filter": {
        "include": {
          "label": "real-btrfs"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
